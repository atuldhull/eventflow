# ============ APPLICATION ============
NEXT_PUBLIC_APP_NAME="EventFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NODE_ENV="development"

# ============ DATABASE ============
DATABASE_URL="postgresql://user:password@localhost:5432/eventflow?schema=public"

# ============ AUTHENTICATION ============
# REQUIRED: 32+ char random string (openssl rand -hex 32). AUTH_SECRET is read too; set either.
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ============ EMAIL ============
# REQUIRED in production (sending is refused without it). Use RESEND_API_KEY, or SMTP_*.
EMAIL_FROM="EventFlow <noreply@eventflow.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ============ PAYMENTS (Razorpay only) ============
# Test keys (rzp_test_...) from dashboard.razorpay.com -> Settings -> API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard -> Settings -> Webhooks: URL https://<your-domain>/api/webhooks/razorpay, events
# payment.captured, order.paid, payment.failed, refund.processed; paste the secret here.
RAZORPAY_WEBHOOK_SECRET=""

# ============ FILE STORAGE (server disk) ============
# Where /api/upload stores files (served at /uploads/*). Must NOT be inside public/. Default: ./uploads
# Back this folder up; on Docker it is the uploads_data volume.
UPLOAD_DIR=""

# ============ SECURITY ============
# REQUIRED: 32+ char random string. Generate with: openssl rand -hex 32
TICKET_SECRET=""
# REQUIRED for /api/cron/release-holds (frees unpaid seats after 15 min). Call it every 5 min:
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://<your-domain>/api/cron/release-holds
CRON_SECRET=""

# ============ LEGAL CONTACTS (shown on /privacy, /terms, /refunds) ============
# Set before launch. India's DPDP Act needs a named grievance officer people can write to.
NEXT_PUBLIC_PRIVACY_EMAIL=""
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_GRIEVANCE_OFFICER=""
NEXT_PUBLIC_LEGAL_ENTITY=""
NEXT_PUBLIC_LEGAL_JURISDICTION=""

# ============ ERROR ALERTS ============
# Recommended in production. Either or both:
#   SENTRY_DSN         from sentry.io (free tier): Project -> Settings -> Client Keys (DSN)
#   ALERT_WEBHOOK_URL  a Slack "incoming webhook" or Discord channel webhook (https://...)
# Server crashes and browser crashes are sent there (the same error at most once per 5 min).
SENTRY_DSN=""
ALERT_WEBHOOK_URL=""

# ============ DOCKER COMPOSE (read from .env, not .env.local) ============
# Only for docker-compose.yml on your server. See DEPLOY.md.
# DOMAIN="events.yourcollege.in"     # Caddy gets the HTTPS certificate for it
# POSTGRES_PASSWORD="long-random"    # also put it in DATABASE_URL in .env.local
# CRON_SECRET="same as above"        # the scheduler container calls the cron jobs with it
# BACKUP_KEEP_DAYS="14"

# ============ ANALYTICS ============
GOOGLE_SITE_VERIFICATION=""

# ============ MAINTENANCE ============
# "true" shows the maintenance page to everyone except super admins (also switchable in /super-admin/settings)
MAINTENANCE_MODE=""
MAINTENANCE_MESSAGE=""

# ============ ENTERPRISE CUSTOM DOMAINS ============
# What a customer's domain must point to before /domain/verify accepts it
CUSTOM_DOMAIN_CNAME_TARGET="cname.eventflow.com"
# Or A records: comma-separated server IPs
CUSTOM_DOMAIN_IPS=""

# ============ OPTIONAL MODULES ============
# OpenWeatherMap key for the event weather module
WEATHER_API_KEY=""

# ============ MORE THAN ONE APP SERVER (optional) ============
# Only needed when running more than one app server (or container replica) behind a load
# balancer. With a single server leave all of these empty: rate limits are counted in memory
# and uploads are stored in UPLOAD_DIR, exactly as above.
#
# Shared rate limits (sign-in lockouts, registration and API limits) across all servers.
# e.g. redis://:password@redis-host:6379 (rediss:// for TLS). If Redis is down or slow, each
# server falls back to its own in-memory counts (logged once).
REDIS_URL=""
#
# Uploads in an S3-compatible bucket instead of UPLOAD_DIR, so every server sees every file.
# Works with AWS S3, Cloudflare R2, Backblaze B2 and MinIO; setting S3_BUCKET turns it on.
# Files are still served by the app at /uploads/<name>, so the bucket can stay private.
# Existing files in UPLOAD_DIR are not moved: copy them to the bucket root under the same names.
#   S3_REGION    AWS: e.g. ap-south-1 (default us-east-1). R2: auto. B2: e.g. us-west-004
#   S3_ENDPOINT  empty for AWS. R2: https://<account-id>.r2.cloudflarestorage.com
#                B2: https://s3.<region>.backblazeb2.com   MinIO: http://minio:9000
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: a key limited to this bucket (read, write, delete)
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
