# ============ APPLICATION ============
NEXT_PUBLIC_APP_NAME="EventFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"
NODE_ENV="development"

# ============ DATABASE ============
DATABASE_URL="postgresql://user:password@localhost:5432/eventflow?schema=public"

# ============ REDIS ============
REDIS_URL="redis://localhost:6379"

# ============ AUTHENTICATION ============
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ============ EMAIL ============
EMAIL_FROM="EventFlow <noreply@eventflow.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ============ PAYMENTS ============
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ============ FILE STORAGE ============
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# ============ SECURITY ============
# REQUIRED: 32+ char random string. Generate with: openssl rand -hex 32
TICKET_SECRET=""
API_KEY_SALT="your-api-key-salt-here"

# ============ ANALYTICS ============
GOOGLE_SITE_VERIFICATION=""
GOOGLE_ANALYTICS_ID=""

# ============ PLATFORM ============
PLATFORM_COMMISSION_PERCENTAGE="0"
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"
