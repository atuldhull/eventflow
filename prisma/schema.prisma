generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  SUPER_ADMIN
  ENTERPRISE_ADMIN
  ENTERPRISE_MANAGER
  ORG_ADMIN
  EVENT_MANAGER
  COORDINATOR
  FINANCE_MANAGER
  VIEWER
  USER
}

enum AccountType {
  ENTERPRISE
  ORGANIZATION
  INDIVIDUAL
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
  POSTPONED
}

enum EventType {
  SINGLE
  MULTI_DAY
  MULTI_TRACK
  RECURRING
  HYBRID
  VIRTUAL
  IN_PERSON
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
  UNLISTED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
  CANCELLED
  CHECKED_IN
  NO_SHOW
}

enum RegistrationType {
  INDIVIDUAL
  TEAM
  DELEGATION
  INVITE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  BANK_TRANSFER
  CASH
  FREE
  COUPON
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
  TRANSFERRED
}

enum NotificationType {
  EMAIL
  SMS
  IN_APP
  WHATSAPP
  PUSH
}

enum NotificationCategory {
  REGISTRATION
  PAYMENT
  REMINDER
  UPDATE
  ANNOUNCEMENT
  CERTIFICATE
  SYSTEM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  APPROVE
  REJECT
  REFUND
  CHECK_IN
  PUBLISH
  CANCEL
}

enum FieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  FILE_UPLOAD
  URL
}

enum CertificateStatus {
  PENDING
  GENERATED
  SENT
  DOWNLOADED
}

enum FeedbackStatus {
  PENDING
  SUBMITTED
  REVIEWED
}

// ============================================================================
// AUTH MODELS
// ============================================================================

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime? @map("email_verified")
  phone            String?   @unique
  phoneVerified    Boolean   @default(false) @map("phone_verified")
  passwordHash     String?   @map("password_hash")
  name             String
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  avatar           String?
  bio              String?   @db.Text
  role             Role      @default(USER)
  isActive         Boolean   @default(true) @map("is_active")
  isBanned         Boolean   @default(false) @map("is_banned")
  banReason        String?   @map("ban_reason")
  lastLoginAt      DateTime? @map("last_login_at")
  lastLoginIp      String?   @map("last_login_ip")
  collegeName      String?   @map("college_name")
  companyName      String?   @map("company_name")
  designation      String?
  city             String?
  state            String?
  country          String?   @default("India")
  dateOfBirth      DateTime? @map("date_of_birth")
  gender           String?
  interests        String[]
  metadata         Json?
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  accounts                Account[]
  sessions                Session[]
  refreshTokens           RefreshToken[]
  otps                    OTP[]
  ownedEnterprises        Enterprise[]
  enterpriseMemberships   EnterpriseMember[]
  organizationMemberships OrganizationMember[]
  eventsCreated           Event[]               @relation("EventCreator")
  eventsManaged           EventTeamMember[]
  registrations           Registration[]
  payments                Payment[]
  tickets                 Ticket[]
  checkIns                CheckIn[]             @relation("CheckInUser")
  checkInsPerformed       CheckIn[]             @relation("CheckInPerformer")
  certificates            Certificate[]
  notifications           Notification[]        @relation("NotificationRecipient")
  sentNotifications       Notification[]        @relation("NotificationSender")
  feedbacks               Feedback[]
  teamMemberships         TeamMember[]
  teamsLed                Team[]
  auditLogs               AuditLog[]
  announcements           Announcement[]
  mediaUploaded           EventMedia[]
  certificateTemplates    CertificateTemplate[]
  contactMessages         ContactMessage[]
  waitlistEntries         WaitlistEntry[]
  apiKeys                 ApiKey[]
  webhookEndpoints        WebhookEndpoint[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?  @map("token_type")
  scope             String?
  id_token          String?  @db.Text
  session_state     String?  @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model OTP {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String?
  phone     String?
  code      String
  purpose   String
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([code])
  @@index([purpose])
  @@map("otps")
}

// ============================================================================
// TENANT MODELS
// ============================================================================

model Enterprise {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?   @db.Text
  logo           String?
  banner         String?
  website        String?
  email          String
  phone          String?
  address        String?   @db.Text
  city           String?
  state          String?
  country        String?   @default("India")
  type           String?
  isVerified     Boolean   @default(false) @map("is_verified")
  isActive       Boolean   @default(true) @map("is_active")
  ownerId        String    @map("owner_id")
  primaryColor   String?   @default("#000000") @map("primary_color")
  secondaryColor String?   @default("#ffffff") @map("secondary_color")
  customDomain   String?   @unique @map("custom_domain")
  subdomain      String?   @unique
  socialLinks    Json?     @map("social_links")
  settings       Json?
  subscriptionId String?   @unique @map("subscription_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subscription         Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  organizations        Organization[]
  members              EnterpriseMember[]
  events               Event[]
  coupons              Coupon[]
  auditLogs            AuditLog[]
  certificateTemplates CertificateTemplate[]
  apiKeys              ApiKey[]
  webhookEndpoints     WebhookEndpoint[]
  siteConfig           SiteConfig?
  featureModuleData    FeatureModuleData[]

  @@index([slug])
  @@index([ownerId])
  @@index([isActive])
  @@index([type])
  @@map("enterprises")
}

model EnterpriseMember {
  id           String   @id @default(cuid())
  enterpriseId String   @map("enterprise_id")
  userId       String   @map("user_id")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  joinedAt     DateTime @default(now()) @map("joined_at")
  invitedBy    String?  @map("invited_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  enterprise Enterprise @relation(fields: [enterpriseId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enterpriseId, userId])
  @@index([enterpriseId])
  @@index([userId])
  @@map("enterprise_members")
}

model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  description    String?   @db.Text
  logo           String?
  banner         String?
  website        String?
  email          String
  phone          String?
  address        String?   @db.Text
  city           String?
  state          String?
  country        String?   @default("India")
  category       String?
  enterpriseId   String?   @map("enterprise_id")
  isVerified     Boolean   @default(false) @map("is_verified")
  isActive       Boolean   @default(true) @map("is_active")
  primaryColor   String?   @default("#000000") @map("primary_color")
  secondaryColor String?   @default("#ffffff") @map("secondary_color")
  socialLinks    Json?     @map("social_links")
  settings       Json?
  maxEvents      Int?      @default(10) @map("max_events")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  // Relations
  enterprise           Enterprise?           @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  members              OrganizationMember[]
  events               Event[]
  subscriptions        Subscription[]
  auditLogs            AuditLog[]
  certificateTemplates CertificateTemplate[]
  apiKeys              ApiKey[]
  webhookEndpoints     WebhookEndpoint[]
  siteConfig           SiteConfig?
  featureModuleData    FeatureModuleData[]

  @@index([slug])
  @@index([enterpriseId])
  @@index([isActive])
  @@index([category])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role
  isActive       Boolean  @default(true) @map("is_active")
  joinedAt       DateTime @default(now()) @map("joined_at")
  invitedBy      String?  @map("invited_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ============================================================================
// EVENT MODELS
// ============================================================================

model Event {
  id                    String          @id @default(cuid())
  title                 String
  slug                  String          @unique
  description           String          @db.Text
  shortDescription      String?         @map("short_description")
  status                EventStatus     @default(DRAFT)
  type                  EventType       @default(SINGLE)
  visibility            EventVisibility @default(PUBLIC)
  category              String?
  tags                  String[]
  startDate             DateTime        @map("start_date")
  endDate               DateTime        @map("end_date")
  registrationStartDate DateTime?       @map("registration_start_date")
  registrationEndDate   DateTime?       @map("registration_end_date")
  timezone              String          @default("Asia/Kolkata")
  venue                 String?
  venueAddress          String?         @map("venue_address") @db.Text
  venueCity             String?         @map("venue_city")
  venueState            String?         @map("venue_state")
  venueCountry          String?         @map("venue_country")
  venueLatitude         Float?          @map("venue_latitude")
  venueLongitude        Float?          @map("venue_longitude")
  isOnline              Boolean         @default(false) @map("is_online")
  onlinePlatform        String?         @map("online_platform")
  onlineLink            String?         @map("online_link")
  onlinePassword        String?         @map("online_password")
  coverImage            String?         @map("cover_image")
  thumbnailImage        String?         @map("thumbnail_image")
  gallery               String[]
  maxCapacity           Int?            @map("max_capacity")
  currentRegistrations  Int             @default(0) @map("current_registrations")
  waitlistEnabled       Boolean         @default(false) @map("waitlist_enabled")
  waitlistCapacity      Int?            @map("waitlist_capacity")
  approvalRequired      Boolean         @default(false) @map("approval_required")
  isFeatured            Boolean         @default(false) @map("is_featured")
  isPaid                Boolean         @default(false) @map("is_paid")
  minTeamSize           Int?            @map("min_team_size")
  maxTeamSize           Int?            @map("max_team_size")
  allowTeamRegistration Boolean         @default(false) @map("allow_team_registration")
  rules                 String?         @db.Text
  termsAndConditions    String?         @map("terms_and_conditions") @db.Text
  refundPolicy          String?         @map("refund_policy") @db.Text
  contactEmail          String?         @map("contact_email")
  contactPhone          String?         @map("contact_phone")
  organizationId        String?         @map("organization_id")
  enterpriseId          String?         @map("enterprise_id")
  createdById           String          @map("created_by_id")
  parentEventId         String?         @map("parent_event_id")
  settings              Json?
  seoTitle              String?         @map("seo_title")
  seoDescription        String?         @map("seo_description")
  seoKeywords           String[]        @map("seo_keywords")
  publishedAt           DateTime?       @map("published_at")
  cancelledAt           DateTime?       @map("cancelled_at")
  cancellationReason    String?         @map("cancellation_reason")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  // Relations
  organization      Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  enterprise        Enterprise?         @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  createdBy         User                @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  parentEvent       Event?              @relation("SubEvents", fields: [parentEventId], references: [id], onDelete: SetNull)
  subEvents         Event[]             @relation("SubEvents")
  sessions          EventSession[]
  ticketTypes       TicketType[]
  registrations     Registration[]
  customFormFields  CustomFormField[]
  announcements     Announcement[]
  media             EventMedia[]
  feedbacks         Feedback[]
  certificates      Certificate[]
  coupons           Coupon[]
  checkIns          CheckIn[]
  teamMembers       EventTeamMember[]
  sponsors          EventSponsor[]
  faqs              EventFAQ[]
  teams             Team[]
  notifications     Notification[]
  payments          Payment[]
  tickets           Ticket[]
  auditLogs         AuditLog[]
  waitlistEntries   WaitlistEntry[]
  featureModuleData FeatureModuleData[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@index([visibility])
  @@index([category])
  @@index([startDate])
  @@index([endDate])
  @@index([organizationId])
  @@index([enterpriseId])
  @@index([createdById])
  @@index([isFeatured])
  @@index([parentEventId])
  @@map("events")
}

model EventSession {
  id            String   @id @default(cuid())
  eventId       String   @map("event_id")
  title         String
  description   String?  @db.Text
  speaker       String?
  speakerBio    String?  @map("speaker_bio") @db.Text
  speakerAvatar String?  @map("speaker_avatar")
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  venue         String?
  track         String?
  capacity      Int?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns CheckIn[]

  @@index([eventId])
  @@index([startTime])
  @@index([track])
  @@map("event_sessions")
}

model EventTeamMember {
  id          String   @id @default(cuid())
  eventId     String   @map("event_id")
  userId      String   @map("user_id")
  role        String
  permissions String[]
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_team_members")
}

model TicketType {
  id            String    @id @default(cuid())
  eventId       String    @map("event_id")
  name          String
  description   String?
  price         Decimal   @default(0) @db.Decimal(10, 2)
  currency      String    @default("INR")
  quantity      Int?
  sold          Int       @default(0)
  maxPerUser    Int       @default(1) @map("max_per_user")
  saleStartDate DateTime? @map("sale_start_date")
  saleEndDate   DateTime? @map("sale_end_date")
  isActive      Boolean   @default(true) @map("is_active")
  isHidden      Boolean   @default(false) @map("is_hidden")
  sortOrder     Int       @default(0) @map("sort_order")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets       Ticket[]
  registrations Registration[]

  @@index([eventId])
  @@index([isActive])
  @@map("ticket_types")
}

// ============================================================================
// REGISTRATION & TICKETING MODELS
// ============================================================================

model Registration {
  id                 String             @id @default(cuid())
  registrationNumber String             @unique @map("registration_number")
  eventId            String             @map("event_id")
  userId             String             @map("user_id")
  ticketTypeId       String             @map("ticket_type_id")
  status             RegistrationStatus @default(PENDING)
  type               RegistrationType   @default(INDIVIDUAL)
  teamId             String?            @map("team_id")
  formResponses      Json?              @map("form_responses")
  notes              String?            @db.Text
  approvedAt         DateTime?          @map("approved_at")
  approvedBy         String?            @map("approved_by")
  rejectedAt         DateTime?          @map("rejected_at")
  rejectedBy         String?            @map("rejected_by")
  rejectionReason    String?            @map("rejection_reason")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancellationReason String?            @map("cancellation_reason")
  waitlistPosition   Int?               @map("waitlist_position")
  source             String?
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  // Relations
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  team       Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ticket     Ticket?
  payment    Payment?
  checkIn    CheckIn?

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([ticketTypeId])
  @@index([status])
  @@index([type])
  @@index([teamId])
  @@index([registrationNumber])
  @@map("registrations")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  eventId     String   @map("event_id")
  leaderId    String   @map("leader_id")
  maxSize     Int      @map("max_size")
  currentSize Int      @default(1) @map("current_size")
  isComplete  Boolean  @default(false) @map("is_complete")
  inviteCode           String    @unique @map("invite_code")
  inviteCodeExpiresAt  DateTime? @map("invite_code_expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leader        User           @relation(fields: [leaderId], references: [id], onDelete: Restrict)
  members       TeamMember[]
  registrations Registration[]

  @@index([eventId])
  @@index([leaderId])
  @@index([inviteCode])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Ticket {
  id             String       @id @default(cuid())
  ticketNumber   String       @unique @map("ticket_number")
  registrationId String       @unique @map("registration_id")
  ticketTypeId   String       @map("ticket_type_id")
  userId         String       @map("user_id")
  eventId        String       @map("event_id")
  status         TicketStatus @default(ACTIVE)
  qrCode         String       @unique @map("qr_code")
  qrCodeUrl      String?      @map("qr_code_url")
  barcode        String?      @unique
  seatNumber     String?      @map("seat_number")
  validFrom      DateTime?    @map("valid_from")
  validUntil     DateTime?    @map("valid_until")
  transferredTo  String?      @map("transferred_to")
  transferredAt  DateTime?    @map("transferred_at")
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns     CheckIn[]

  @@index([ticketNumber])
  @@index([qrCode])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("tickets")
}

// ============================================================================
// PAYMENT MODELS
// ============================================================================

model Payment {
  id               String        @id @default(cuid())
  paymentNumber    String        @unique @map("payment_number")
  registrationId   String        @unique @map("registration_id")
  userId           String        @map("user_id")
  eventId          String        @map("event_id")
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("INR")
  status           PaymentStatus @default(PENDING)
  method           PaymentMethod
  gatewayOrderId   String?       @map("gateway_order_id")
  gatewayPaymentId String?       @map("gateway_payment_id")
  gatewaySignature String?       @map("gateway_signature")
  gatewayResponse  Json?         @map("gateway_response")
  receiptUrl       String?       @map("receipt_url")
  invoiceNumber    String?       @map("invoice_number")
  taxAmount        Decimal?      @map("tax_amount") @db.Decimal(10, 2)
  discountAmount   Decimal?      @map("discount_amount") @db.Decimal(10, 2)
  couponId         String?       @map("coupon_id")
  refundId         String?       @map("refund_id")
  refundAmount     Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  refundReason     String?       @map("refund_reason")
  refundedAt       DateTime?     @map("refunded_at")
  paidAt           DateTime?     @map("paid_at")
  failedAt         DateTime?     @map("failed_at")
  failureReason    String?       @map("failure_reason")
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  coupon       Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([paymentNumber])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([method])
  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@map("payments")
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  eventId        String?  @map("event_id")
  enterpriseId   String?  @map("enterprise_id")
  discountType   String   @map("discount_type")
